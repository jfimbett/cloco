# Copy to .env (gitignored) and fill in for THIS machine. Paths may use ~.
# Roots referenced by ${VAR} placeholders in data/registry.json
DROPBOX_ROOT=~/Dropbox
DATA_ROOT=
# WRDS (optional). Preferred: ~/.pgpass line  wrds-pgdata.wharton.upenn.edu:9737:wrds:USER:PASSWORD
WRDS_USERNAME=
WRDS_PASSWORD=
